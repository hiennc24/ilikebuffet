{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@ilikebuffet/shared": ["../../packages/shared/src/index.ts"],
      "@ilikebuffet/shared/test": ["../../packages/shared/test/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
