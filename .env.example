# Copy to .env for local dev. Never commit real secrets.

# Owner/admin connection — used by Prisma migrate, generate, and drift tooling.
DATABASE_URL="postgresql://ilikebuffet:ilikebuffet@localhost:5432/ilikebuffet?schema=public"

# App RUNTIME connection — a NON-owner role so the audit-log REVOKE layer applies
# (an owner-class connection bypasses it; Red Team H1). Provision via
# scripts/provision-app-roles.sql + scripts/apply-audit-guards.sh. If unset, the
# app falls back to DATABASE_URL (fine for a fresh local DB, NOT for production).
APP_DATABASE_URL="postgresql://ilikebuffet_app:ilikebuffet_app@localhost:5432/ilikebuffet?schema=public"

REDIS_URL="redis://localhost:6379"
TZ="Asia/Ho_Chi_Minh"
PORT=3000
