// ILikeBuffet — single Prisma schema, one owner across P4/P6/P7 to avoid
// parallel migration races (orchestration rule in plan.md).
//
// P3 adds: Role enum, Branch, AppUser, UserBranch, Device.
// P4 adds: Branch fields (address/phone/operatingHours/bankAccount/billInfo),
//          IngredientGroup, Ingredient, IngredientPurchaseUnit, Unit,
//          AccountGroup, Account, Supplier, SupplierIngredient,
//          HolidayCalendar, HolidayEntry.
// P6 adds: TicketType, TimeWindow, PriceBookVersion, PriceCell,
//          DiscountProgram, DiscountReason, BranchPriceFlag.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

/// 6 fixed roles (NT-02). No custom roles in MVP.
enum Role {
  QUAN_TRI_HQ // Quản trị HQ — system administrator
  CHU_CHUOI // Chủ chuỗi — chain owner
  KE_TOAN_CHUOI // Kế toán chuỗi — chain accountant
  QUAN_LY_CN // Quản lý CN — branch manager
  THU_NGAN // Thu ngân — cashier
  THU_KHO // Thủ kho — warehouse keeper
}

/// Branch operational status.
enum BranchStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

/// Device operational status (M3: typed enum, not bare String).
enum DeviceStatus {
  ACTIVE
  SUSPENDED
}

/// Ingredient lifecycle status.
enum IngredientStatus {
  ACTIVE
  INACTIVE // "Ngừng sử dụng" — deactivated after transactions exist (NT-03.2)
}

/// Account flow type — income (Thu) or expense (Chi).
enum AccountFlow {
  INCOME // Thu
  EXPENSE // Chi
}

/// Supplier scope — chain-wide or specific branch.
enum SupplierScope {
  CHAIN_WIDE
  BRANCH_SPECIFIC
}

/// Supplier approval status for branch-scoped NCC (NT-03.5).
enum SupplierStatus {
  ACTIVE
  PENDING_HQ // Chờ HQ duyệt
  INACTIVE
}

/// Ticket type lifecycle (VG-01): once billed, only deactivate — no hard delete.
enum TicketTypeStatus {
  ACTIVE
  INACTIVE // "Ngừng bán" — deactivated after billing history exists (VG-01.3)
}

/// Discount kind (VG-03.1).
enum DiscountKind {
  PERCENT // Giảm % trên tổng
  FIXED_AMOUNT // Giảm số tiền cố định
  VOUCHER // Mã voucher nhập tại quầy
}

/// Discount program lifecycle.
enum DiscountProgramStatus {
  ACTIVE
  INACTIVE
}

/// Shift lifecycle (BH-01). FORCE_CLOSED = a hung prior shift closed with a
/// manager PIN so a device can open a new one (BH-01.4); its figures are frozen
/// for the later finance wave (TC-03) — M1 only marks + audits it.
enum ShiftStatus {
  OPEN
  CLOSED
  FORCE_CLOSED
}

/// Bill lifecycle (BH-06). CANCELLED keeps its number (no gap in the range).
enum BillStatus {
  COMPLETED
  CANCELLED
}

/// Payment method (BH-03). Combined payments = multiple Payment rows on a bill.
enum PaymentMethod {
  CASH
  VIETQR
  CARD
}

/// Purchase-order lifecycle. DRAFT is editable; SENT is issued to the supplier;
/// RECEIVED means goods were booked into stock; CANCELLED voids the order.
enum PoStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

/// Kind of stock movement. RECEIPT adds stock (goods in), ISSUE removes it
/// (wastage/consumption), ADJUST sets a counted quantity (stock-take delta).
enum StockMovementType {
  RECEIPT
  ISSUE
  ADJUST
}

/// Reconciliation state of an inbound bank transfer (VietQR auto-reconcile).
enum BankTxStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

// ─── Domain models ───────────────────────────────────────────────────────────

/// A physical or logical branch (cửa hàng / chi nhánh). Extended in P4 (NT-01).
model Branch {
  id     String       @id @default(cuid())
  /// Short unique code, 2–5 uppercase letters, e.g. "CN01". IMMUTABLE after transactions (enforced in service layer).
  code   String       @unique @db.VarChar(5)
  name   String
  status BranchStatus @default(ACTIVE)

  // NT-01.1 required fields
  address String
  phone   String @db.VarChar(20)

  /// Operating hours per weekday. JSON: { "MON": { "open": "10:30", "close": "22:00" }, ... }
  /// Keys: MON TUE WED THU FRI SAT SUN. Null = closed that day.
  operatingHours Json? @db.JsonB

  // NT-01.2 optional fields
  /// Bank account for VietQR (BH-03). Stored as JSON { number, bank, holder }.
  bankAccount Json?   @db.JsonB
  /// Bill header override — null = inherit chain default.
  billInfo    Json?   @db.JsonB
  /// Logo URL override — null = inherit chain default.
  logoUrl     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  users             UserBranch[]
  devices           Device[]
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  stockMovements    StockMovement[]
  inventoryBalances InventoryBalance[]

  @@map("branch")
}

/// App user (staff account). Maps to app_user table (avoids clash with PG reserved "user").
model AppUser {
  id                 String    @id @default(cuid())
  username           String    @unique
  passwordHash       String
  role               Role
  /// true = Chủ chuỗi / Kế toán chuỗi / HQ — access all branches without UserBranch rows.
  chainWide          Boolean   @default(false)
  /// Force password change on first login (NT-02.5).
  mustChangePassword Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  /// Absolute timestamp until which the account is locked. Null = not locked.
  lockedUntil        DateTime? @db.Timestamptz(3)
  /// Argon2-hashed 6-digit approval PIN for QUAN_LY_CN (NT-02.7). Separate from cashierPinHash.
  approvalPinHash    String?
  /// Argon2-hashed 6-digit cashier PIN for THU_NGAN device quick-login (NT-04). Separate from approvalPinHash.
  cashierPinHash     String?
  pinFailedCount     Int       @default(0)
  pinLockedUntil     DateTime? @db.Timestamptz(3)
  /// Incremented on logout-all or account lock; carried in JWT (tv claim).
  /// Per-request revocation check in Redis ≤30s (Red Team M4/V2).
  tokenVersion       Int       @default(0)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)

  branches UserBranch[]

  @@map("app_user")
}

/// Many-to-many: user ↔ branch membership. Chain-wide users have no rows here.
model UserBranch {
  userId   String
  branchId String

  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branch")
}

/// Registered POS device. Server-issued deviceId + per-device secret (argon2-hashed).
/// Unregistered devices are denied PIN quick-login (Red Team H4).
model Device {
  id         String       @id @default(cuid())
  /// Server-issued, returned once at registration.
  deviceId   String       @unique @default(cuid())
  branchId   String
  secretHash String // argon2 hash of the one-time secret
  label      String?
  status     DeviceStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id])

  @@map("device")
}

// ─── Master Data: Units ───────────────────────────────────────────────────────

/// Unit of measure catalog (kg, lít, cái, chai, …). Shared across chain.
model Unit {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(20) // e.g. "KG", "LIT", "CAI"
  name      String // e.g. "Kilogram", "Lít", "Cái"
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  ingredients        Ingredient[]
  purchaseUnits      IngredientPurchaseUnit[]
  purchaseOrderLines PurchaseOrderLine[]

  @@map("unit")
}

// ─── Master Data: Ingredient Groups & Ingredients ────────────────────────────

/// Ingredient group with default wastage %. HQ-manageable (NT-03.1).
model IngredientGroup {
  id                String   @id @default(cuid())
  name              String   @unique // "Hải sản tươi", "Thịt", etc.
  /// Default wastage percentage for the group (0–100). Overridable per ingredient.
  defaultWastagePct Decimal  @default(0) @db.Decimal(5, 2)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  ingredients Ingredient[]

  @@map("ingredient_group")
}

/// Ingredient (nguyên liệu). Code auto-generated, editable before first transaction (NT-03.1).
model Ingredient {
  id              String           @id @default(cuid())
  /// Short code — auto-generated (e.g. "NL001"), editable before any transaction.
  code            String           @unique @db.VarChar(20)
  name            String
  groupId         String
  unitId          String // base unit
  /// Wastage % override. Null = inherit from group.
  wastagePct      Decimal?         @db.Decimal(5, 2)
  /// Default minimum stock level (override per CN in KH-04 later).
  defaultMinStock Decimal          @default(0) @db.Decimal(12, 3)
  status          IngredientStatus @default(ACTIVE)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)

  group              IngredientGroup          @relation(fields: [groupId], references: [id])
  unit               Unit                     @relation(fields: [unitId], references: [id])
  purchaseUnits      IngredientPurchaseUnit[]
  suppliers          SupplierIngredient[]
  purchaseOrderLines PurchaseOrderLine[]
  stockMovements     StockMovement[]
  inventoryBalances  InventoryBalance[]
  ticketTypeRecipes  TicketTypeRecipe[]

  @@map("ingredient")
}

/// Up to 3 purchase units per ingredient with conversion factor (NT-03.1).
/// e.g. thùng = 10 kg (factorToBase = 10).
model IngredientPurchaseUnit {
  id           String  @id @default(cuid())
  ingredientId String
  unitId       String
  /// How many base units this purchase unit equals. Must be > 0.
  factorToBase Decimal @db.Decimal(12, 6)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  unit       Unit       @relation(fields: [unitId], references: [id])

  @@unique([ingredientId, unitId])
  @@map("ingredient_purchase_unit")
}

// ─── Master Data: Chart of Accounts ──────────────────────────────────────────

/// Account group (Nhóm khoản) — top level of the 2-level chart of accounts (NT-03.4).
model AccountGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  accounts Account[]

  @@map("account_group")
}

/// Account (Khoản thu-chi) — leaf node of the 2-level chart of accounts (NT-03.4).
model Account {
  id                   String      @id @default(cuid())
  groupId              String
  name                 String
  flow                 AccountFlow // Thu or Chi
  /// Approval threshold in integer VND (NT-03.4 — used by TC-01). 0 = no threshold.
  approvalThresholdVnd Int         @default(0)
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)

  group AccountGroup @relation(fields: [groupId], references: [id])

  @@unique([groupId, name])
  @@map("account")
}

// ─── Master Data: Suppliers ───────────────────────────────────────────────────

/// Supplier (NCC — Nhà cung cấp). NT-03.5.
model Supplier {
  id        String         @id @default(cuid())
  name      String
  taxCode   String?        @db.VarChar(20) // MST
  contact   String? // phone/email/address (freeform for MVP)
  debtTerms Int            @default(0) // days
  scope     SupplierScope  @default(CHAIN_WIDE)
  status    SupplierStatus @default(ACTIVE)
  /// Set when scope=BRANCH_SPECIFIC — the branch this supplier is scoped to.
  branchId  String?
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  branch         Branch?              @relation(fields: [branchId], references: [id])
  ingredients    SupplierIngredient[]
  purchaseOrders PurchaseOrder[]

  @@map("supplier")
}

/// Many-to-many: supplier ↔ ingredient (NT-03.5 "mặt hàng cung cấp").
model SupplierIngredient {
  supplierId   String
  ingredientId String

  supplier   Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([supplierId, ingredientId])
  @@map("supplier_ingredient")
}

// ─── Master Data: Holiday Calendar (Red Team M2) ─────────────────────────────

/// Holiday calendar — P6 (day-type pricing) and P8 (offline price cache) depend on this.
/// Added in P4 to maintain 1-owner schema rule (plan.md invariant).
model HolidayCalendar {
  id        String   @id @default(cuid())
  /// Year this calendar applies to (solar year, e.g. 2025).
  year      Int
  name      String // e.g. "Lịch lễ 2025"
  /// Optional branch — null = applies chain-wide.
  branchId  String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  entries HolidayEntry[]

  @@unique([year, branchId])
  @@map("holiday_calendar")
}

/// Individual holiday date within a calendar.
model HolidayEntry {
  id         String   @id @default(cuid())
  calendarId String
  /// The holiday date (date only — stored as Timestamptz at midnight UTC for Prisma compat).
  date       DateTime @db.Date
  name       String // e.g. "Tết Nguyên Đán", "30 Tết", "Giỗ Tổ Hùng Vương"
  /// True = lunar-calendar date (custom, e.g. "30 Tết") — must be explicitly entered per year.
  isCustom   Boolean  @default(false)

  calendar HolidayCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date])
  @@map("holiday_entry")
}

// ─── P6: Sales — Ticket Types ────────────────────────────────────────────────

/// Ticket type (Loại vé). HQ-managed, chain-wide catalog (VG-01).
/// No hard delete once a bill exists — deactivate only (VG-01.3).
/// Free flag: price always = 0 but COUNTS toward guest total (VG-01.2, M7).
model TicketType {
  id           String           @id @default(cuid())
  name         String // e.g. "Người lớn", "Trẻ em 1m–1m3"
  description  String? // Điều kiện áp dụng — printed on bill (VG-01.1)
  displayOrder Int              @default(0) // POS button sort order (VG-01.1)
  color        String           @default("#3B82F6") @db.VarChar(20) // hex or tailwind token
  isFree       Boolean          @default(false) // Giá luôn = 0, vẫn đếm khách (VG-01.2)
  status       TicketTypeStatus @default(ACTIVE)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  priceCells PriceCell[]
  recipe     TicketTypeRecipe[]

  @@map("ticket_type")
}

// ─── P6: Sales — Time Windows ────────────────────────────────────────────────

/// Time window (Khung giờ). HQ defines; no overlaps enforced in service (VG-02.1).
/// startMinute/endMinute = minutes since midnight (0–1439).
model TimeWindow {
  id           String   @id @default(cuid())
  name         String // e.g. "Trưa", "Tối"
  startMinute  Int // inclusive, 0–1439
  endMinute    Int // exclusive, 1–1440 (endMinute > startMinute)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  priceCells PriceCell[]

  @@map("time_window")
}

// ─── P6: Sales — Price Book Versions & Cells ─────────────────────────────────

/// A price book version. Immutable once effectiveFrom <= now (VG-02.3).
/// branchId null = chain-wide. Branch-specific requires BranchPriceFlag.allowOwnPrice=true.
model PriceBookVersion {
  id            String   @id @default(cuid())
  name          String // e.g. "Bảng giá Q1/2026"
  effectiveFrom DateTime @db.Date // Date only; version is active from 0h that day (VN time)
  branchId      String? // null = chain-wide version
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  createdBy     String? // actorId

  cells PriceCell[]

  @@map("price_book_version")
}

/// One price cell: version × ticket-type × time-window × day-type → unit price VND.
/// day-type: "REGULAR" | "WEEKEND" | "HOLIDAY" (priority: HOLIDAY>WEEKEND>REGULAR).
/// branchId null = chain-wide cell; branch cell overrides chain cell (VG-02.4).
model PriceCell {
  id           String  @id @default(cuid())
  versionId    String
  ticketTypeId String
  timeWindowId String
  /// "REGULAR" | "WEEKEND" | "HOLIDAY"
  dayType      String  @db.VarChar(20)
  /// Unit price in integer VND. 0 for free-ticket cells.
  priceVnd     Int
  /// null = chain-wide cell; set = branch-specific override (VG-02.4)
  branchId     String?

  version    PriceBookVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  ticketType TicketType       @relation(fields: [ticketTypeId], references: [id])
  timeWindow TimeWindow       @relation(fields: [timeWindowId], references: [id])

  @@unique([versionId, ticketTypeId, timeWindowId, dayType, branchId])
  @@map("price_cell")
}

/// Branch-level flag: allow own price book (VG-02.4).
model BranchPriceFlag {
  branchId      String  @id
  allowOwnPrice Boolean @default(false)

  @@map("branch_price_flag")
}

// ─── P6: Sales — Discounts & Vouchers ────────────────────────────────────────

/// Discount / voucher program (VG-03.1). HQ creates; max 1 per bill (MVP).
model DiscountProgram {
  id             String                @id @default(cuid())
  name           String
  kind           DiscountKind
  /// Percent (0–100) for PERCENT kind. Null for FIXED_AMOUNT/VOUCHER.
  pct            Int?
  /// Fixed amount VND for FIXED_AMOUNT kind. Null for PERCENT/VOUCHER.
  amountVnd      Int?
  /// Voucher code (case-insensitive). Required for VOUCHER kind.
  voucherCode    String?               @db.VarChar(100)
  /// Voucher quota — max total redemptions. Null = unlimited.
  quotaTotal     Int?
  /// Remaining redemptions (decremented with FOR UPDATE lock, VG-03.4).
  quotaRemaining Int?
  /// Effective date range (inclusive). Null = open-ended.
  validFrom      DateTime?             @db.Date
  validUntil     DateTime?             @db.Date
  /// JSON array of branchIds this program applies to. Null = all branches.
  branchScope    Json?                 @db.JsonB
  status         DiscountProgramStatus @default(ACTIVE)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)

  @@map("discount_program")
}

/// Predefined manual-discount reasons (VG-03.3). HQ-managed catalog.
model DiscountReason {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "Khách phàn nàn", "Người quen chủ"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("discount_reason")
}

// ─── Infra probe ─────────────────────────────────────────────────────────────

/// Infra-only. NOT domain data. Exists so the test harness can demonstrate a
/// reproducible migration and a real `SELECT ... FOR UPDATE` row lock.
model HealthProbe {
  id        Int      @id @default(autoincrement())
  label     String   @unique
  updatedAt DateTime @updatedAt

  @@map("_health_probe")
}

/// GA-01 append-only audit trail. Immutability is enforced at the DB level
/// (REVOKE UPDATE/DELETE on the app role + a BEFORE UPDATE/DELETE trigger that
/// blocks every non-superuser) — see prisma/sql/audit-immutability.sql and
/// audit-role-grants.sql. Those are applied OUTSIDE Prisma migrations (Prisma
/// does not model triggers/roles) so the schema/migration drift check stays clean.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String? // user id; null for system / pre-auth events
  actorRole  String?
  action     String // e.g. "bill.cancel", "auth.login_failed"
  objectType String // e.g. "bill", "user", "session"
  objectId   String?
  branchId   String? // CN — cross-branch access is auditable (wired in P3)
  deviceId   String?
  before     Json?    @db.JsonB
  after      Json?    @db.JsonB
  reason     String?
  approvedBy String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([branchId, action, createdAt])
  @@index([objectType, objectId])
  @@map("audit_log")
}

// ─── Sales: shifts, bills, payments (P7 — BH-01→04, BH-06, BH-07) ─────────────

/// A cashier shift on one device (BH-01). At most one OPEN shift per device is
/// enforced by a partial unique index (see migration) — Prisma can't express
/// "unique where status = OPEN", so it is added as raw SQL in the migration.
model Shift {
  id              String      @id @default(cuid())
  branchId        String
  deviceId        String
  /// Business date the shift belongs to (VN calendar day). Drives bill numbering.
  businessDate    DateTime    @db.Date
  status          ShiftStatus @default(OPEN)
  openedBy        String // actorId (THU_NGAN)
  openedAt        DateTime    @default(now()) @db.Timestamptz(3)
  openingCashVnd  Int // tiền đầu ca
  /// Close-out fields (BH-07). Null until closed.
  closedBy        String?
  closedAt        DateTime?   @db.Timestamptz(3)
  /// Theoretical cash = opening + cash bill payments (M1 minimal; receipts/vouchers = later wave).
  expectedCashVnd Int?
  /// Counted cash entered at close.
  countedCashVnd  Int?
  /// countedCash − expectedCash. Negative = short. Non-zero requires a note.
  varianceVnd     Int?
  varianceNote    String?
  /// When a shift is force-closed to unstick a device, the manager who approved it.
  forceClosedBy   String?
  /// Highest device-issued temp sequence for this shift, uploaded at close (C8).
  /// Reconciliation compares synced temp numbers against this high-water-mark to
  /// tell a voided/never-synced bill (hole below HWM) from mere absence.
  tempHighWater   Int?

  bills Bill[]

  @@index([branchId, businessDate])
  @@index([deviceId, status])
  @@map("shift")
}

/// Gapless per-(branch, business date) bill counter (BH-02). The next number is
/// allocated inside the bill-create transaction via SELECT … FOR UPDATE on this
/// row, then lastNo + 1. NOT a SEQUENCE (rollback would skip numbers). last_no
/// is reconcilable from MAX(bill.seq) for DR (Red Team C7).
model BillCounter {
  branchId     String
  businessDate DateTime @db.Date
  lastNo       Int      @default(0)

  @@id([branchId, businessDate])
  @@map("bill_counter")
}

/// A sales bill (BH-02). Money is server-authoritative: the client sends only
/// (ticketType, qty); the server prices each line via the P6 resolver and
/// snapshots names/prices so later price-book edits never mutate a closed bill.
model Bill {
  id               String     @id @default(cuid())
  /// Human number "[CODE]-[YYMMDD]-[NNNN]" — gapless per branch+date.
  number           String     @unique
  /// Monotonic per (branch, businessDate) sequence backing `number` (DR reconcile, C7).
  seq              Int
  branchId         String
  shiftId          String
  deviceId         String
  businessDate     DateTime   @db.Date
  status           BillStatus @default(COMPLETED)
  /// Deciding price timestamp (createdAt by default; V1) — snapshot input.
  createdBy        String
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  paidAt           DateTime?  @db.Timestamptz(3)
  totalVnd         Int
  guestCount       Int // number of tickets incl. free (denominator for cost/guest, M7)
  /// Offline dedup key (P8): unique per device so a re-synced create is idempotent.
  clientUuid       String?
  /// Device-issued temp number "[CN]-[YYMMDD]-T[DEVICE_SHORT][NNN]" stored for audit (P8 C8).
  tempNumber       String?
  /// SHA-256 of the offline bill's semantic content (shift + createdAt + sorted
  /// lines). On a dedup hit, a different hash for the same (device,uuid) means
  /// tampering/corruption → reject + audit, never silently return the number (C1).
  contentHash      String?
  /// Device wall-clock at bill creation + skew vs server last-known-good (H5).
  deviceClockAt    DateTime? @db.Timestamptz(3)
  clockOffsetMs    Int?
  /// Set when the bill is accepted but flagged for accounting review — e.g. a
  /// clock skew beyond tolerance, or a force-closed stuck offline bill (H5/H3).
  /// The sale is NEVER rejected; quarantine just routes it to reconciliation.
  quarantined      Boolean   @default(false)
  quarantineReason String?
  /// Reconciliation review (GA-02): set when a manager marks a quarantined bill handled.
  quarantineResolvedAt   DateTime? @db.Timestamptz(3)
  quarantineResolvedBy   String?
  quarantineResolveNote  String?
  /// Cancellation (BH-06) — number is retained.
  cancelledBy      String?
  cancelledAt      DateTime?  @db.Timestamptz(3)
  cancelReason     String?
  cancelApprovedBy String?

  shift    Shift      @relation(fields: [shiftId], references: [id])
  lines    BillLine[]
  payments Payment[]
  refunds  Refund[]

  @@unique([branchId, businessDate, seq])
  @@unique([deviceId, clientUuid])
  @@index([shiftId])
  @@index([branchId, businessDate])
  @@map("bill")
}

/// A refund against a paid bill. Partial refunds = several rows; the sum plus any
/// new refund must not exceed the bill total (validated server-side, in-tx).
model Refund {
  id         String        @id @default(cuid())
  billId     String
  amountVnd  Int
  method     PaymentMethod
  reason     String
  /// User who performed the refund.
  refundedBy String
  /// Manager whose approval PIN authorised it.
  approvedBy String
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("refund")
}

/// One line on a bill — fully snapshotted (no live FK to the price book).
model BillLine {
  id             String  @id @default(cuid())
  billId         String
  ticketTypeId   String
  ticketTypeName String // snapshot
  unitPriceVnd   Int // snapshot — resolved server-side at bill createdAt
  qty            Int
  lineTotalVnd   Int
  isFree         Boolean @default(false)
  /// Pricing context snapshot (for reprint / audit).
  timeWindowId   String?
  timeWindowName String?
  dayType        String? @db.VarChar(20)
  priceVersionId String?

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("bill_line")
}

/// A payment against a bill (BH-03). Combined payment = several rows; the sum
/// must equal the bill total (validated server-side).
model Payment {
  id        String        @id @default(cuid())
  billId    String
  method    PaymentMethod
  /// Amount applied to the bill. Sum of amountVnd across a bill's payments
  /// equals the bill total (validated server-side).
  amountVnd Int
  /// Cash handed over by the customer for a CASH payment (>= amountVnd). Null
  /// for non-cash or exact-pay. changeVnd = tenderedVnd - amountVnd.
  tenderedVnd Int?
  /// Change returned to the customer for a cash over-tender. Server-computed.
  changeVnd   Int?
  /// Bank/card reference for VietQR/CARD (manual confirm; auto-reconcile later).
  reference String?
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("payment")
}

// ─── Inventory: Purchase Orders, Stock Movements, Balances ────────────────────

/// Purchase order (đơn mua) to a supplier, scoped to one branch. Editable while
/// DRAFT; SENT is issued; a receipt moves it to RECEIVED. Money is integer VND;
/// line quantities are fractional (kg/lít) so line totals use roundVnd(price×qty).
model PurchaseOrder {
  id         String   @id @default(cuid())
  /// Human-readable code, unique per branch (e.g. "PO-CN01-0001").
  code       String   @unique
  branchId   String
  supplierId String
  status     PoStatus @default(DRAFT)
  note       String?
  /// actorId of the creator (AppUser.id). Scalar, like shift.openedBy.
  createdBy  String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  branch   Branch             @relation(fields: [branchId], references: [id])
  supplier Supplier           @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]

  @@index([branchId, status])
  @@index([supplierId])
  @@map("purchase_order")
}

/// One line of a purchase order: an ingredient bought in a chosen purchase unit.
model PurchaseOrderLine {
  id           String  @id @default(cuid())
  poId         String
  ingredientId String
  /// Purchase unit chosen for this line (an ingredient_purchase_unit's unit).
  unitId       String
  /// Ordered quantity in the purchase unit (fractional allowed).
  qty          Decimal @db.Decimal(12, 3)
  /// Price of one purchase unit, integer VND.
  unitPriceVnd Int
  /// roundVnd(unitPriceVnd × qty), integer VND.
  lineTotalVnd Int

  po         PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  ingredient Ingredient    @relation(fields: [ingredientId], references: [id])
  unit       Unit          @relation(fields: [unitId], references: [id])

  @@index([poId])
  @@map("purchase_order_line")
}

/// Append-only ledger of every stock change. qtyBase is signed and always in the
/// ingredient's BASE unit; the running InventoryBalance is reconstructable from
/// SUM(qtyBase) per (branch, ingredient).
model StockMovement {
  id           String            @id @default(cuid())
  branchId     String
  ingredientId String
  type         StockMovementType
  /// Signed quantity in the ingredient's base unit (+ in / − out).
  qtyBase      Decimal           @db.Decimal(12, 3)
  /// Cost of one base unit at movement time, integer VND. Null for a pure ADJUST.
  unitCostVnd  Int?
  /// What produced this movement, e.g. refType "PO" + refId = purchase_order.id.
  refType      String?
  refId        String?
  note         String?
  /// actorId (AppUser.id).
  createdBy    String
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  branch     Branch     @relation(fields: [branchId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([branchId, ingredientId, createdAt])
  @@map("stock_movement")
}

/// Income/expense entry (phiếu thu-chi) against the chart of accounts (E3). The
/// account's flow is snapshotted; over account.approvalThresholdVnd needs a
/// manager PIN (approvedBy set). supplierId links a supplier payment (F2). Scalar
/// FKs (resolved to names in the service), like shift.branchId.
model FinancialTransaction {
  id         String        @id @default(cuid())
  code       String        @unique
  branchId   String
  accountId  String
  flow       AccountFlow
  amountVnd  Int
  method     PaymentMethod
  occurredAt DateTime      @db.Timestamptz(3)
  note       String?
  supplierId String?
  createdBy  String
  approvedBy String?
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)

  @@index([branchId, occurredAt])
  @@index([accountId])
  @@map("financial_transaction")
}

/// Inter-branch stock transfer (điều chuyển kho) — M10. Atomic: on create, each
/// line issues from the source and receives into the destination in one tx,
/// carrying the source's moving-average cost. The two legs are StockMovements
/// tagged refType "TRANSFER" + refId = this transfer's id. Scalar branch FKs
/// (resolved to codes in the service), like shift.branchId.
model StockTransfer {
  id           String   @id @default(cuid())
  code         String   @unique
  fromBranchId String
  toBranchId   String
  note         String?
  createdBy    String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  lines StockTransferLine[]

  @@index([fromBranchId])
  @@index([toBranchId])
  @@map("stock_transfer")
}

/// One moved ingredient: qty in base units + the source unit cost snapshotted.
model StockTransferLine {
  id           String  @id @default(cuid())
  transferId   String
  ingredientId String
  qtyBase      Decimal @db.Decimal(12, 3)
  /// Source moving-average cost at transfer time (carried to the destination).
  unitCostVnd  Int

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@map("stock_transfer_line")
}

/// Current on-hand quantity and moving-average cost per (branch, ingredient).
/// Maintained inside the same transaction as each movement; reconstructable from
/// stock_movement for disaster recovery.
model InventoryBalance {
  branchId     String
  ingredientId String
  /// On-hand quantity in the ingredient's base unit. Never negative (blocked).
  qtyBase      Decimal  @db.Decimal(12, 3)
  /// Moving-average cost of one base unit, integer VND.
  avgCostVnd   Int      @default(0)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  branch     Branch     @relation(fields: [branchId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([branchId, ingredientId])
  @@index([branchId])
  @@map("inventory_balance")
}

/// Per-ticket-type ingredient recipe (định mức): estimated base-unit consumption
/// of one ingredient per one ticket sold. Chain-wide (no branch). Selling a
/// ticket deducts Σ(qtyBase × ticket qty) from the bill's branch stock.
model TicketTypeRecipe {
  id           String   @id @default(cuid())
  ticketTypeId String
  ingredientId String
  /// null = chain-wide default; a branch id = that branch's override (M7).
  branchId     String?
  /// Estimated consumption of one base unit of this ingredient per one ticket.
  qtyBase      Decimal  @db.Decimal(12, 4)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  // Uniqueness is enforced by two PARTIAL unique indexes in the migration (one
  // for chain-wide rows where branchId IS NULL, one per-branch) — Postgres treats
  // NULLs as distinct, so a single compound @@unique can't dedupe chain-wide rows.
  // branchId is a scalar FK (no Prisma relation), like shift.branchId.
  @@index([ticketTypeId, branchId])
  @@map("ticket_type_recipe")
}

/// An inbound bank transfer received via the Sepay webhook (VietQR auto-reconcile).
/// Stored idempotently per (provider, providerTxId); matched to an unpaid bill by
/// amount + bill-number-in-content, else left for manual review. rawPayload keeps
/// the original webhook body for audit. branchId/matchedBillId are scalar FKs
/// (SET NULL on delete) so the reconciliation record outlives the bill.
model BankTransaction {
  id            String       @id @default(cuid())
  provider      String       @default("sepay")
  /// The provider's own transaction id — the idempotency key.
  providerTxId  String
  gateway       String?
  accountNumber String?
  amountVnd     Int
  /// Transfer memo (the customer's transfer content); matched against bill number.
  content       String
  referenceCode String?
  transferredAt DateTime     @db.Timestamptz(3)
  status        BankTxStatus @default(UNMATCHED)
  matchedBillId String?
  branchId      String?
  note          String?
  rawPayload    Json         @db.JsonB
  receivedAt    DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([provider, providerTxId])
  @@index([status, receivedAt])
  @@map("bank_transaction")
}
